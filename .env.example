# ============================================================
# Price Drop Alert — Root .env.example
# Copy this file to .env and fill in real values.
# NEVER commit a .env file with real credentials.
# ============================================================

NODE_ENV=development
PORT=5000

# Comma-separated list of allowed browser origins (no trailing slash).
# Local dev:  CLIENT_URL=http://localhost:3000
# Production: CLIENT_URL=https://your-app.vercel.app
CLIENT_URL=http://localhost:3000

# ------ Database ------
# Local Mongo:    MONGODB_URI=mongodb://127.0.0.1:27017/price_drop_alert
# Atlas (remote): MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/price_drop_alert

# ------ Redis / BullMQ (optional) ------
# Set REDIS_ENABLED=false to disable Redis and run direct-cron instead.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# ------ JWT ------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be 32+ characters in production.
JWT_SECRET=replace_with_at_least_32_random_characters_here
JWT_REFRESH_SECRET=replace_with_another_32_random_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ------ PricesAPI (scraping) ------
# Sign up at https://pricesapi.io — leave blank to use direct HTML scraping.
PRICES_API_KEY=
PRICES_API_BASE_URL=https://api.pricesapi.io/api/v1
PRICES_API_DEFAULT_COUNTRY=us
PRICES_API_SEARCH_LIMIT=3
PRICES_API_OFFERS_LIMIT=10

# ------ Twilio (SMS / WhatsApp alerts) ------
# Obtain from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# ------ Email / SMTP (OTP delivery) ------
EMAIL_FROM=noreply@pricedrop.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# ------ Cron schedule ------
# Default: once a day at midnight UTC.  Use cron syntax.
PRICE_TRACKING_CRON=0 0 * * *

# ------ Vite frontend (optional) ------
# Leave blank — Vite dev server proxies /api to :5000 automatically.
VITE_API_URL=
