# ============================================================
# Price Drop Alert — Backend .env.example
# Copy to backend/.env and fill in real values.
# NEVER commit a .env with real credentials.
# ============================================================

NODE_ENV=development
PORT=5000

# Allowed browser origins (comma-separated, no trailing slash)
CLIENT_URL=http://localhost:3000

# ------ Database ------
MONGODB_URI=mongodb://127.0.0.1:27017/price_drop_alert
# Atlas: MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# ------ Redis / BullMQ (optional) ------
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379

# ------ JWT ------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_at_least_32_random_characters_here
JWT_REFRESH_SECRET=replace_with_another_32_random_characters_here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_COST_PASSWORD=12

# ------ Cron / scraping schedule ------
PRICE_TRACKING_CRON=0 0 * * *
PRICE_HISTORY_RETENTION_DAYS=365

# ------ PricesAPI ------
# Leave blank to fall back to direct HTML scraping.
PRICES_API_KEY=
PRICES_API_BASE_URL=https://api.pricesapi.io/api/v1
PRICES_API_DEFAULT_COUNTRY=us
PRICES_API_SEARCH_LIMIT=3
PRICES_API_OFFERS_LIMIT=10

# ------ Twilio (SMS / WhatsApp) ------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# ------ Email / SMTP (OTP delivery) ------
EMAIL_FROM=noreply@pricedrop.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=
EMAIL_PASS=

# ------ OTP ------
OTP_EXPIRY_MINUTES=10
